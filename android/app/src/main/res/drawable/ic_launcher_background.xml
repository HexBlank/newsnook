<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Full-bleed square background. The launcher applies the final mask. -->
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="92"
                android:endX="94"
                android:endY="14"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#FF0C6FFF" />
                <item android:offset="0.55" android:color="#FF3EAEFF" />
                <item android:offset="1" android:color="#FF75DBFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft center glow; VectorDrawable supports a circular radial gradient. -->
    <path android:pathData="M0,0H108V108H0Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="53"
                android:centerY="77"
                android:gradientRadius="44"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#852A86FF" />
                <item android:offset="1" android:color="#002A86FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
