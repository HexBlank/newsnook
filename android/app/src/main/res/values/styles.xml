<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- DayNight 的默认窗口底色在浅色系统下是白的，WebView 首帧前会闪一帧白屏 -->
        <item name="android:windowBackground">#0E0F12</item>
        <item name="android:colorBackground">#0E0F12</item>
        <!-- 旧系统仍认这些；Android 15+ 边到边时底色由 Web safe-area 条承担 -->
        <item name="android:statusBarColor">#0E0F12</item>
        <item name="android:navigationBarColor">#0E0F12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- 系统开屏与 WebView 首帧之间不能露白：窗口底、图标底、开屏底同色 -->
        <item name="android:background">#0E0F12</item>
        <item name="android:windowBackground">#0E0F12</item>
        <item name="android:colorBackground">#0E0F12</item>
        <item name="windowSplashScreenBackground">#0E0F12</item>
        <!-- Android 12+ 图标背后默认会铺一圈浅色；透明图标仍会闪白圆 -->
        <item name="windowSplashScreenIconBackgroundColor">#0E0F12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">#0E0F12</item>
        <item name="android:navigationBarColor">#0E0F12</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
